# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > API)

# URL do projeto
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave pública (anon / publishable)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de administrador (service_role / secret). SECRETA: nunca compartilhe nem publique.
# Usada apenas no servidor, para criar usuários.
SUPABASE_SERVICE_ROLE_KEY=
